# Max Agency — environment variables
#
# Copy this to ~/.hermes/.env (WSL) and fill in your values.
# The .env file is loaded by all Hermes processes and by orchestrator-mechanics.sh.
#
# PROJECT_REPO is required. All others are optional.

# Required: the GitHub repo this agency instance manages (owner/repo slug, no URL)
PROJECT_REPO=your-github-username/your-project-repo

# OpenRouter API key — recommended provider for Hermes agent models
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Telegram (optional, usually already set) — Max Agency does not manage its own
# Telegram bot. If your Hermes installation already has TELEGRAM_BOT_TOKEN and
# TELEGRAM_HOME_CHANNEL set here for its own gateway, the orchestrator reuses
# them automatically for human-review escalations and merge requests. If unset,
# escalations go to ~/.hermes/profiles/orchestrator/escalations.log instead.
