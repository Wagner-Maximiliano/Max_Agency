[Unit]
Description=Max Agency Orchestrator Tick
After=network.target

[Service]
Type=oneshot
EnvironmentFile=/home/hermes/.hermes/.env
# The Environment= line with the machine-specific PATH is added by Hermes setup.
# To see the current value: grep ^Environment= ~/.config/systemd/user/hermes-orchestrator-tick.service
ExecStart=/bin/bash -c 'L=/home/hermes/.hermes/profiles/orchestrator/cron-output.log; echo "=== TICK $(date -Iseconds) ===" >> "$L"; git -C /home/hermes/.hermes-cache/Max_Agency pull --rebase 2>&1 | grep -v "^Already up to date" >> "$L" || true; /home/hermes/.local/bin/hermes -p orchestrator chat -m nvidia/nemotron-3-super-120b-a12b:free -q "$(cat /home/hermes/.hermes-cache/Max_Agency/hermes-config/poll-prompts/orchestrator-tick.md)" -Q --accept-hooks --yolo --max-turns 60 2>&1 | tail -5 >> "$L"'
TimeoutStartSec=1800

[Install]
WantedBy=default.target
