[Unit]
Description=Max Agency Orchestrator Tick
After=network.target

[Service]
Type=oneshot
EnvironmentFile=/home/hermes/.hermes/.env
# The Environment= line with the machine-specific PATH is added by Hermes setup.
# To see the current value: grep ^Environment= ~/.config/systemd/user/hermes-orchestrator-tick.service
# Pull the cache first, then exec the (freshly-updated) runner. The runner runs
# mechanics deterministically every tick and only spawns the LLM on kickoffs.
ExecStart=/bin/bash -c 'git -C /home/hermes/.hermes-cache/Max_Agency pull --rebase >/dev/null 2>&1 || true; exec /bin/bash /home/hermes/.hermes-cache/Max_Agency/hermes-config/orchestrator-tick-runner.sh'
TimeoutStartSec=300

[Install]
WantedBy=default.target
