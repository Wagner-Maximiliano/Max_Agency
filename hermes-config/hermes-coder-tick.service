[Unit]
Description=Max Agency Coder Tick
After=network.target

[Service]
Type=oneshot
EnvironmentFile=/home/hermes/.hermes/.env
# The Environment= line with the machine-specific PATH is added by Hermes setup.
# To see the current value: grep ^Environment= ~/.config/systemd/user/hermes-coder-tick.service
ExecStart=/bin/bash -c 'L=/home/hermes/.hermes/profiles/coder/cron-output.log; echo "=== TICK $(date -Iseconds) ===" >> "$L"; /home/hermes/.local/bin/hermes -p coder chat -q "$(cat /home/hermes/.hermes-cache/Max_Agency/hermes-config/poll-prompts/coder-tick.md)" -Q --accept-hooks --yolo --max-turns 30 2>&1 | tail -1 >> "$L"'
TimeoutStartSec=1200

[Install]
WantedBy=default.target
